# Copy to .env and fill in. Never commit .env. All variables are read only by core/config.py.
# Anything marked (prod) is required when ENV=prod; the app refuses to start without it.

# --- runtime
ENV=dev                         # dev | test | prod
LOG_LEVEL=INFO

# --- database (Neon). Use the *test* branch locally, never production.
DATABASE_URL=                   # (prod) POOLED URL: host contains "-pooler". Used by the API.
DATABASE_URL_DIRECT=            # (prod) DIRECT URL. Used by Alembic and the worker.

# --- accounts (ADR-0021: open sign-up, one personal workspace per account)
OWNER_EMAIL=                    # your address: once verified, that account is the platform admin
SETUP_TOKEN=                    # (prod) asked for when someone signs up with OWNER_EMAIL
SIGNUPS_ENABLED=true            # kill switch: false closes sign-up at once; login keeps working
# Sign-up stays CLOSED outside dev until both email and Turnstile below are configured.

# --- email for 6-digit codes. Unset in dev: codes are printed in the API log instead.
# Brevo free (300/day, no card): smtp-relay.brevo.com, 587, SMTP login + key from the dashboard.
# Or Gmail: smtp.gmail.com, 587, your address + an app password (needs 2-step verification).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls          # starttls (587) | ssl (465)
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=                      # e.g. Slate <you@example.com>; must be a verified sender

# --- Cloudflare Turnstile bot check (free, no card). Unset in dev: allowed.
# Dashboard -> Turnstile -> Add widget; hostnames: your Vercel domain and localhost.
TURNSTILE_SITE_KEY=             # public; the API serves it to the browser
TURNSTILE_SECRET_KEY=

# --- secrets generated by you
TRUSTED_IP_HEADER=              # behind Vercel: x-vercel-forwarded-for (leave empty locally)
SESSION_SECRET=                 # (prod) 64+ random chars: python -c "import secrets;print(secrets.token_urlsafe(64))"
# Encrypts connector secrets such as email app passwords (ADR-0028). Required for live email.
# Rotate by putting the new key first: "new,old" (every listed key decrypts).
CREDENTIALS_FERNET_KEY=         # uv run python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"

# --- models (M1+)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini       # answers and query rewriting (ADR-0022)
CHAT_MIN_SIMILARITY=0.20            # answer gate; tune with evals.run --embedder openai
OPENAI_EMBED_MODEL=text-embedding-3-small
EMBED_DIMS=1024
CF_ACCOUNT_ID=                  # Cloudflare Workers AI (BGE-M3, evals only)
CF_API_TOKEN=
GEMINI_API_KEY=                 # query rewriting on public data only
GROQ_API_KEY=                   # query rewriting on public data only
MONTHLY_LLM_BUDGET_USD=5            # hard stop for everyone
DAILY_LLM_BUDGET_USD=0.50           # a burst of sign-ups can use one day's share at most
WORKSPACE_MONTHLY_BUDGET_USD=0.25   # per account, so one user can't crowd out the rest
WORKSPACE_DAILY_BUDGET_USD=0.05

# --- storage (M1): Neon Object Storage, filled by `neon deploy` / `neon env pull` (ADR-0014)
# WARNING: those commands also rewrite DATABASE_URL to the linked branch; restore the test URL.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
UPLOADS_BUCKET=uploads

# --- worker trigger + connectors
GITHUB_DISPATCH_TOKEN=          # fine-grained PAT: Actions/contents write on this repo only
GITHUB_REPO=what-the-sherlock/Slate
# GitHub App (ADR-0023). Create it at github.com/settings/apps; see ROADMAP M4 notes.
GITHUB_APP_ID=
GITHUB_APP_SLUG=                 # from github.com/apps/<slug>
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=          # the .pem contents; newlines may be written as \n
# Discord (ADR-0027): one bot users add to their servers. Developer portal -> your app:
#   Bot: copy the token; turn on "Message Content Intent" (without it messages have no text)
#   OAuth2: copy the client id/secret; add the redirect below; turn on "Requires OAuth2 Code Grant"
NEW_ACCOUNT_DAILY_BUDGET_USD=0.01  # first 7 days of a workspace (ADR-0029)
APP_URL=http://localhost:3000   # invite links point here (ADR-0030); https://<web host> in prod
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/sources/discord/callback

# --- observability
SENTRY_DSN=
