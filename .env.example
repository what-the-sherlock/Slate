# Copy to .env and fill in. Never commit .env. All variables are read only by core/config.py.
# Anything marked (prod) is required when ENV=prod; the app refuses to start without it.

# --- runtime
ENV=dev                         # dev | test | prod
LOG_LEVEL=INFO

# --- database (Neon). Use the *test* branch locally, never production.
DATABASE_URL=                   # (prod) POOLED URL: host contains "-pooler". Used by the API.
DATABASE_URL_DIRECT=            # (prod) DIRECT URL. Used by Alembic and the worker.

# --- secrets generated by you
SESSION_SECRET=                 # (prod) 64+ random chars: python -c "import secrets;print(secrets.token_urlsafe(64))"
CREDENTIALS_FERNET_KEY=         # (prod, M4) python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"

# --- models (M1+)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_EMBED_MODEL=text-embedding-3-small
EMBED_DIMS=1024
CF_ACCOUNT_ID=                  # Cloudflare Workers AI (BGE-M3, evals only)
CF_API_TOKEN=
GEMINI_API_KEY=                 # query rewriting on public data only
GROQ_API_KEY=                   # query rewriting on public data only
MONTHLY_LLM_BUDGET_USD=5

# --- storage (M1)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=uploads

# --- worker trigger + connectors
GITHUB_DISPATCH_TOKEN=          # fine-grained PAT: Actions/contents write on this repo only
GITHUB_REPO=what-the-sherlock/Slate
GITHUB_TOKEN=                   # (M4) read access for the GitHub connector
DISCORD_BOT_TOKEN=              # (M5)

# --- observability
SENTRY_DSN=
