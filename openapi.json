{
  "components": {
    "schemas": {
      "BeginUploadBody": {
        "properties": {
          "filename": {
            "examples": [
              "handbook.pdf"
            ],
            "maxLength": 255,
            "minLength": 1,
            "title": "Filename",
            "type": "string"
          },
          "sha256": {
            "description": "Hex SHA-256 of the file, computed in the browser.",
            "maxLength": 64,
            "minLength": 64,
            "title": "Sha256",
            "type": "string"
          },
          "size": {
            "description": "Bytes, as reported by the browser.",
            "examples": [
              183244
            ],
            "minimum": 0.0,
            "title": "Size",
            "type": "integer"
          },
          "visibility": {
            "default": "only_me",
            "enum": [
              "only_me",
              "workspace",
              "public"
            ],
            "title": "Visibility",
            "type": "string"
          }
        },
        "required": [
          "filename",
          "size",
          "sha256"
        ],
        "title": "BeginUploadBody",
        "type": "object"
      },
      "BeginUploadResponse": {
        "properties": {
          "document_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Document Id"
          },
          "filename": {
            "title": "Filename",
            "type": "string"
          },
          "status": {
            "enum": [
              "upload",
              "duplicate",
              "processing",
              "visibility_differs",
              "indexed"
            ],
            "title": "Status",
            "type": "string"
          },
          "upload": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PresignedPost"
              },
              {
                "type": "null"
              }
            ]
          },
          "upload_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Upload Token"
          }
        },
        "required": [
          "status",
          "filename"
        ],
        "title": "BeginUploadResponse",
        "type": "object"
      },
      "CompleteUploadBody": {
        "properties": {
          "upload_token": {
            "maxLength": 4096,
            "minLength": 10,
            "title": "Upload Token",
            "type": "string"
          }
        },
        "required": [
          "upload_token"
        ],
        "title": "CompleteUploadBody",
        "type": "object"
      },
      "CompleteUploadResponse": {
        "properties": {
          "document_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Document Id"
          },
          "job_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Job Id"
          },
          "status": {
            "enum": [
              "upload",
              "duplicate",
              "processing",
              "visibility_differs",
              "indexed"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "CompleteUploadResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "examples": [
              "0.1.0"
            ],
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "JobOut": {
        "properties": {
          "attempts": {
            "title": "Attempts",
            "type": "integer"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "filename": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Filename"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "dead"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "status",
          "attempts",
          "error",
          "filename"
        ],
        "title": "JobOut",
        "type": "object"
      },
      "LoginBody": {
        "properties": {
          "email": {
            "examples": [
              "ada@acme.dev"
            ],
            "maxLength": 254,
            "minLength": 3,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginBody",
        "type": "object"
      },
      "MeResponse": {
        "properties": {
          "is_guest": {
            "title": "Is Guest",
            "type": "boolean"
          },
          "role": {
            "enum": [
              "owner",
              "admin",
              "member",
              "viewer"
            ],
            "title": "Role",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/MeUser"
          },
          "workspace_id": {
            "format": "uuid",
            "title": "Workspace Id",
            "type": "string"
          }
        },
        "required": [
          "user",
          "workspace_id",
          "role",
          "is_guest"
        ],
        "title": "MeResponse",
        "type": "object"
      },
      "MeUser": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name"
        ],
        "title": "MeUser",
        "type": "object"
      },
      "PresignedPost": {
        "properties": {
          "fields": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Send these form fields first, then the file.",
            "title": "Fields",
            "type": "object"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url",
          "fields"
        ],
        "title": "PresignedPost",
        "type": "object"
      },
      "ReadinessResponse": {
        "properties": {
          "database": {
            "title": "Database",
            "type": "boolean"
          },
          "expected_revision": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "0001"
            ],
            "title": "Expected Revision"
          },
          "migration_revision": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "examples": [
              "0001"
            ],
            "title": "Migration Revision"
          },
          "migrations_current": {
            "title": "Migrations Current",
            "type": "boolean"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database",
          "migrations_current",
          "migration_revision",
          "expected_revision"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "RunErrorOut": {
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          },
          "retryable": {
            "title": "Retryable",
            "type": "boolean"
          },
          "stage": {
            "title": "Stage",
            "type": "string"
          }
        },
        "required": [
          "stage",
          "message",
          "retryable"
        ],
        "title": "RunErrorOut",
        "type": "object"
      },
      "RunOut": {
        "properties": {
          "docs_changed": {
            "title": "Docs Changed",
            "type": "integer"
          },
          "docs_failed": {
            "title": "Docs Failed",
            "type": "integer"
          },
          "docs_seen": {
            "title": "Docs Seen",
            "type": "integer"
          },
          "error_summary": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Summary"
          },
          "errors": {
            "items": {
              "$ref": "#/components/schemas/RunErrorOut"
            },
            "title": "Errors",
            "type": "array"
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "started_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "status",
          "started_at",
          "finished_at",
          "docs_seen",
          "docs_changed",
          "docs_failed",
          "error_summary",
          "errors"
        ],
        "title": "RunOut",
        "type": "object"
      },
      "SetupBody": {
        "properties": {
          "email": {
            "examples": [
              "ada@acme.dev"
            ],
            "maxLength": 254,
            "minLength": 3,
            "title": "Email",
            "type": "string"
          },
          "name": {
            "examples": [
              "Ada Lovelace"
            ],
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "password": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "setup_token": {
            "anyOf": [
              {
                "maxLength": 256,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Setup Token"
          },
          "workspace_name": {
            "examples": [
              "Acme"
            ],
            "maxLength": 80,
            "minLength": 1,
            "title": "Workspace Name",
            "type": "string"
          }
        },
        "required": [
          "workspace_name",
          "name",
          "email",
          "password"
        ],
        "title": "SetupBody",
        "type": "object"
      },
      "SetupStatus": {
        "properties": {
          "requires_setup_token": {
            "description": "Whether setup asks for the server's code.",
            "title": "Requires Setup Token",
            "type": "boolean"
          },
          "set_up": {
            "description": "False until the first owner has created the workspace.",
            "title": "Set Up",
            "type": "boolean"
          }
        },
        "required": [
          "set_up",
          "requires_setup_token"
        ],
        "title": "SetupStatus",
        "type": "object"
      },
      "SourceOut": {
        "properties": {
          "connector": {
            "title": "Connector",
            "type": "string"
          },
          "data_class": {
            "enum": [
              "public",
              "private"
            ],
            "title": "Data Class",
            "type": "string"
          },
          "documents": {
            "title": "Documents",
            "type": "integer"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "last_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Error"
          },
          "last_synced_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Synced At"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "status": {
            "enum": [
              "synced",
              "syncing",
              "queued",
              "failed",
              "never",
              "paused"
            ],
            "title": "Status",
            "type": "string"
          },
          "visibility": {
            "enum": [
              "only_me",
              "workspace",
              "public",
              "mixed"
            ],
            "title": "Visibility",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "connector",
          "visibility",
          "data_class",
          "status",
          "documents",
          "last_synced_at",
          "last_error"
        ],
        "title": "SourceOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "Permission-aware knowledge search with cited answers.",
    "title": "Slate API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/guest": {
      "post": {
        "operationId": "guest_api_v1_auth_guest_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Start a read-only guest session",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Sign in with email and password",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "logout_api_v1_auth_logout_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "summary": "Sign out (ends this session)",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/setup": {
      "post": {
        "operationId": "setup_api_v1_auth_setup_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create the workspace and its owner (first run only)",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/status": {
      "get": {
        "operationId": "setup_status_api_v1_auth_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Whether first-run setup has happened",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/healthz": {
      "get": {
        "description": "The process is up. Never touches the database, so it stays cheap and wake-free.",
        "operationId": "healthz_api_v1_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/jobs/{job_id}": {
      "get": {
        "operationId": "get_job_api_v1_jobs__job_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Processing status of one of your uploads",
        "tags": [
          "sources"
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "me_api_v1_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "The signed-in user",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/readyz": {
      "get": {
        "description": "The database answers and its schema is at this build's migration head.",
        "operationId": "readyz_api_v1_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Not ready"
          }
        },
        "summary": "Readiness",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/sources": {
      "get": {
        "operationId": "list_sources_api_v1_sources_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SourceOut"
                  },
                  "title": "Response List Sources Api V1 Sources Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Sources you can see, with status",
        "tags": [
          "sources"
        ]
      }
    },
    "/api/v1/sources/{source_id}/runs": {
      "get": {
        "operationId": "list_runs_api_v1_sources__source_id__runs_get",
        "parameters": [
          {
            "in": "path",
            "name": "source_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Source Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/RunOut"
                  },
                  "title": "Response List Runs Api V1 Sources  Source Id  Runs Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Recent ingestion runs and their errors",
        "tags": [
          "sources"
        ]
      }
    },
    "/api/v1/uploads": {
      "post": {
        "operationId": "begin_upload_api_v1_uploads_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BeginUploadBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BeginUploadResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
